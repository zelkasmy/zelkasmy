import { useEffect, useMemo, useRef, useState } from "react";
import { useNavigate } from "react-router-dom";
import { createPageUrl } from "@/utils";
import { cn } from "@/lib/utils";
import { Search } from "lucide-react";

function normalizeItems(allItems) {
  if (!Array.isArray(allItems)) return [];

  return allItems.flatMap((group) => {
    if (Array.isArray(group?.items)) {
      return group.items.map((item) => ({
        ...item,
        groupLabel: group.label || group.name || "Section",
      }));
    }

    return [{ ...group, groupLabel: group?.groupLabel || group?.group || "Section" }];
  });
}

function QuickSearch({ allItems, onNavigate }) {
  const [open, setOpen] = useState(false);
  const [query, setQuery] = useState("");
  const [highlightIndex, setHighlightIndex] = useState(0);
  const containerRef = useRef(null);
  const navigate = useNavigate();

  const items = useMemo(() => normalizeItems(allItems), [allItems]);

  const results = useMemo(() => {
    if (!query.trim()) return items.slice(0, 6);

    const q = query.toLowerCase();
    return items.filter((i) => {
      const haystack = [i.name, i.groupLabel, i.label].filter(Boolean).join(" ").toLowerCase();
      return haystack.includes(q);
    });
  }, [query, items]);

  useEffect(() => {
    function handleOutside(e) {
      if (containerRef.current && !containerRef.current.contains(e.target)) {
        setOpen(false);
      }
    }

    document.addEventListener("mousedown", handleOutside);
    return () => document.removeEventListener("mousedown", handleOutside);
  }, []);

  useEffect(() => {
    setHighlightIndex(Math.min(highlightIndex, Math.max(results.length - 1, 0)));
  }, [results.length]);

  function go(item) {
    if (!item?.href) return;

    navigate(createPageUrl(item.href));
    setOpen(false);
    setQuery("");
    setHighlightIndex(0);
    onNavigate?.();
  }

  function onKeyDown(e) {
    if (!open) {
      if (e.key === "ArrowDown") {
        setOpen(true);
        e.preventDefault();
      }
      return;
    }

    if (e.key === "ArrowDown") {
      e.preventDefault();
      setHighlightIndex((i) => Math.min(i + 1, Math.max(0, results.length - 1)));
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      setHighlightIndex((i) => Math.max(i - 1, 0));
    } else if (e.key === "Enter") {
      e.preventDefault();
      const item = results[highlightIndex];
      if (item) go(item);
    } else if (e.key === "Escape") {
      setOpen(false);
    }
  }

  return (
    <div ref={containerRef} className="relative w-full max-w-sm">
      <div
        className={cn(
          "flex items-center gap-2 rounded-xl border px-3 py-2 transition-colors",
          open ? "border-[var(--lf-gold)] bg-white" : "border-border bg-muted/40"
        )}
      >
        <Search className="h-4 w-4 shrink-0 text-muted-foreground" />
        <input
          value={query}
          onChange={(e) => setQuery(e.target.value)}
          onFocus={() => setOpen(true)}
          onKeyDown={onKeyDown}
          placeholder="Rechercher une section…"
          aria-expanded={open}
          aria-controls="quicksearch-results"
          aria-autocomplete="list"
          role="combobox"
          className="w-full bg-transparent text-sm outline-none placeholder:text-muted-foreground"
        />
      </div>

      {open && results.length > 0 && (
        <div
          id="quicksearch-results"
          role="listbox"
          aria-activedescendant={results[highlightIndex] ? `qs-${results[highlightIndex].href}` : undefined}
          className="absolute left-0 right-0 top-[calc(100%+6px)] z-50 overflow-hidden rounded-xl border border-border bg-card shadow-xl"
        >
          {results.map((item, idx) => {
            const active = idx === highlightIndex;
            return (
              <button
                id={`qs-${item.href}`}
                key={`${item.href}-${idx}`}
                onMouseDown={(e) => e.preventDefault()}
                onClick={() => go(item)}
                onMouseEnter={() => setHighlightIndex(idx)}
                role="option"
                aria-selected={active}
                className={cn(
                  "flex w-full items-center justify-between gap-3 px-3 py-2.5 text-left text-sm",
                  active ? "bg-muted/70" : "hover:bg-muted"
                )}
              >
                <span className="flex items-center gap-3">
                  <item.icon className="h-4 w-4 text-muted-foreground" />
                  <span>{item.name}</span>
                </span>

                {item.groupLabel && (
                  <span className="text-[10px] uppercase tracking-wide text-muted-foreground">
                    {item.groupLabel}
                  </span>
                )}
              </button>
            );
          })}
        </div>
      )}
    </div>
  );
}

export default QuickSearch;
